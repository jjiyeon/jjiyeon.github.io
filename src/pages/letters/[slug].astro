---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';
import { getPublishedLetters, type Letter } from '../../lib/letters';

// import { render } from 'astro:content';
// import { Image } from 'astro:assets';
// import { getCategory } from '../../lib/categories';
// import { formatDate } from '../../lib/letters';

export async function getStaticPaths() {
  const letters = await getPublishedLetters();

  return letters.map((letter) => ({
    params: { slug: letter.data.letterSlug },
    props: { letter },
  }));
}

interface Props {
  letter: Letter;
}

