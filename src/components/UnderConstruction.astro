---
interface Props {
  title?: string;
  message?: string;
}

const {
  title = '공사중',
  message = '레터 화면을 다듬고 있어요. 곧 찾아뵐게요.',
} = Astro.props;
---

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center gap-4 py-16">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-12 h-12 text-muted"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="6" width="20" height="8" rx="1" />
    <path d="M17 14v7" />
    <path d="M7 14v7" />
    <path d="M17 3v3" />
    <path d="M7 3v3" />
    <path d="M10 14 2.3 6.3" />
    <path d="m14 6 7.7 7.7" />
    <path d="m8 6 8 8" />
  </svg>
  <h1 class="text-2xl font-bold tracking-tight">{title}</h1>
  <p class="text-muted">{message}</p>
</div>
