---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteTitle = "Summer's Dev Letter";
const {
  title = siteTitle,
  description = '일과 개발, 제품, 협업을 매주 정리하는 Summer의 개발레터입니다.',
} = Astro.props;

const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand-slot" aria-label="Home"></a>
      <nav aria-label="Primary navigation">
        <a href="/letters/">Letters</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Summer's Dev Letter · 기록으로 일하는 방식을 선명하게 남깁니다.</p>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
